    }
    id: {
      fo: "uuid"
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of the draft."
      t: "`$STRING`"
    }
    reply_to_email_id: {
      fo: "uuid"
      h: "Reply To Email Id"
      n: "reply_to_email_id"
      r: true
      sh: "The Email ID the draft replies to."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    snippet: {
      h: "Snippet"
      n: "snippet"
      r: true
      sh: "A short preview of the body."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    subject: {
      h: "Subject"
      n: "subject"
      r: true
      sh: "The subject."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    thread_id: {
      fo: "uuid"
      h: "Thread Id"
      n: "thread_id"
      r: true
      sh: "The Thread ID when the draft is a reply."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    to: {
      h: "To"
      n: "to"
      r: true
      sh: "The recipients."
      t: [
        "`$ONE`"
        [
          "`$ARRAY`"
          "`$NULL`"
        ]
      ]
    }
    type: {
      h: "Type"
      n: "type"
      r: true
      sh: "`reply` when the draft replies to an email in an existing thread."
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "Timestamp when the draft was last saved."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "inbox_draft_list_item"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /inboxes/{inbox_id}/drafts"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "inbox_id"
