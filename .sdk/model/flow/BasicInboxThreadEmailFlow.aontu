  step: [
    {
      m: {
        inbox_id: "inbox01",
        thread_id: "thread01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "inbox_thread_email_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInboxThreadEmailFlow"
}