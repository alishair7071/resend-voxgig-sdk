# BasicInboxFlow

main: kit: flow: BasicInboxFlow:
{
  entity: "inbox",
  kind: "basic",
  name: "BasicInboxFlow",
  step: [
    {
      i: {
        ref: "inbox_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "inbox_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "inbox_ref01",
        srcdatavar: "inbox_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-inbox_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "inbox_ref01",
        srcdatavar: "inbox_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "inbox01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-inbox_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicInboxFlow"
}